#!/bin/bash
# Legion Fork Launcher Script
# Supports --hub / hub / --mode / -m flags for interactive flow menus

set -e

HOME_DIR="$HOME"
REPO_DIR="$HOME/Desktop/grok-build-legion-edition/grok-build-legion-edition-main"
PRESETS_DIR="$HOME_DIR/.grok/config-presets"
AUTO_PRESET="$PRESETS_DIR/auto-discovered.toml"

# Resolve tools directory
if [ -d "$REPO_DIR/tools" ]; then
    TOOLS_DIR="$REPO_DIR/tools"
else
    TOOLS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/tools"
fi

# Check for --hub / hub flag
if [ "$1" = "--hub" ] || [ "$1" = "hub" ]; then
    shift
    python3 "$TOOLS_DIR/legion-hub.py" "$@"
    exit 0
fi

# Check for --mode / -m flag
if [ "$1" = "--mode" ] || [ "$1" = "-m" ]; then
    shift
    python3 "$TOOLS_DIR/legion-mode.py" "$@"
    exit 0
fi

# Run Auto-Discovery on first run if auto-discovered.toml is missing
if [ ! -f "$AUTO_PRESET" ]; then
    echo "========================================================"
    echo "🚀 First Run Detected on Legion Fork!"
    echo "Running Zero-Touch Provider & Model Auto-Discovery..."
    echo "========================================================"
    python3 "$TOOLS_DIR/auto-discover.py"
    "$TOOLS_DIR/switch-subagents.sh" auto-discovered
    echo ""
fi

# Locate compiled binary (xai-grok-pager or xai-grok-pager-bin)
if [ -f "$HOME_DIR/.local/bin/xai-grok-pager" ]; then
    exec "$HOME_DIR/.local/bin/xai-grok-pager" "$@"
elif [ -f "$REPO_DIR/target/release/xai-grok-pager" ]; then
    exec "$REPO_DIR/target/release/xai-grok-pager" "$@"
elif [ -f "$REPO_DIR/target/release/xai-grok-pager-bin" ]; then
    exec "$REPO_DIR/target/release/xai-grok-pager-bin" "$@"
else
    echo "Building release binary..."
    cd "$REPO_DIR" && cargo build --release -p xai-grok-pager-bin
    exec "$REPO_DIR/target/release/xai-grok-pager" "$@"
fi
